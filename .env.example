# MIR server configuration — all values optional.
PORT=8787
# Postgres. When set (and reachable), MIR uses PostgreSQL via Drizzle.
# When unset, MIR falls back to embedded Postgres (PGlite) in ./data/pglite.
# DATABASE_URL=postgresql://mir:mir@localhost:5432/mir
DATA_DIR=./data

# Optional AI interpretation layer (OpenAI-compatible endpoint).
# Without these, MIR uses deterministic authored dialogue and the local answer matcher.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
